@{
    ViewData["Title"] = "Dashboard";
    // Serialize dữ liệu từ ViewBag sang JSON để JS đọc được
    var labelsJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ChartLabels);
    var valuesJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ChartValues);
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold text-navy"><i class="bi bi-speedometer2"></i> DASHBOARD QUẢN TRỊ</h1>
            <p class="text-muted mb-0">Hệ thống CSDL Phân tán - Quản lý Bóng đá (3 Nodes)</p>
        </div>
        <button class="btn btn-success btn-sm shadow-sm">
            <i class="bi bi-arrow-clockwise"></i> Làm mới dữ liệu
        </button>
    </div>

    <div class="row mb-4 g-3">
        @foreach (dynamic node in ViewBag.HealthStatus)
        {
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 card-hover">
                    <div class="card-body d-flex align-items-center">
                        <div class="rounded-circle bg-light p-3 me-3 text-primary">
                            <i class="bi bi-server fs-4"></i>
                        </div>
                        <div>
                            <h6 class="card-subtitle text-muted small text-uppercase">@node.Node</h6>
                            <h5 class="card-title mb-0 fw-bold text-navy">@node.IP</h5>
                            <small class="text-success fw-bold"><i class="bi bi-dot"></i> @node.Status</small>
                        </div>
                    </div>
                    <div class="card-footer border-0 py-1 bg-success"></div> 
                </div>
            </div>
        }
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-navy">Phân bố Cầu thủ theo CLB</h5>
                    <span class="badge bg-primary-soft text-primary">Real-time Data</span>
                </div>
                <div class="card-body">
                    <canvas id="playerChart" height="120"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100 bg-navy text-white">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">Truy cập nhanh</h4>
                    
                    <a asp-controller="DoiBong" asp-action="Index" class="d-flex align-items-center text-white text-decoration-none mb-3 p-3 rounded bg-white-10 action-link">
                        <i class="bi bi-shield-shaded fs-3 me-3"></i>
                        <div>
                            <h6 class="mb-0 fw-bold">Quản lý Đội Bóng</h6>
                            <small class="text-white-50">Thêm, xóa, sửa CLB</small>
                        </div>
                        <i class="bi bi-chevron-right ms-auto"></i>
                    </a>

                    <a asp-controller="CauThu" asp-action="Index" class="d-flex align-items-center text-white text-decoration-none mb-3 p-3 rounded bg-white-10 action-link">
                        <i class="bi bi-people-fill fs-3 me-3"></i>
                        <div>
                            <h6 class="mb-0 fw-bold">Hồ sơ Cầu thủ</h6>
                            <small class="text-white-50">Tra cứu thông tin</small>
                        </div>
                        <i class="bi bi-chevron-right ms-auto"></i>
                    </a>

                    <a asp-controller="TranDau" asp-action="Index" class="d-flex align-items-center text-white text-decoration-none p-3 rounded bg-white-10 action-link">
                        <i class="bi bi-calendar-event fs-3 me-3"></i>
                        <div>
                            <h6 class="mb-0 fw-bold">Lịch Thi Đấu</h6>
                            <small class="text-white-50">Ghi nhận kết quả</small>
                        </div>
                        <i class="bi bi-chevron-right ms-auto"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const ctx = document.getElementById('playerChart').getContext('2d');
        
        // Dữ liệu từ Server
        const labels = @Html.Raw(labelsJson);
        const dataValues = @Html.Raw(valuesJson);

        // Tạo Gradient màu cho cột (Tạo cảm giác hiện đại)
        let gradient = ctx.createLinearGradient(0, 0, 0, 400);
        gradient.addColorStop(0, '#10B981'); // Pitch Green
        gradient.addColorStop(1, '#1E3A8A'); // Deep Navy

        new Chart(ctx, {
            type: 'bar', // Dạng biểu đồ cột
            data: {
                labels: labels,
                datasets: [{
                    label: 'Số lượng cầu thủ',
                    data: dataValues,
                    backgroundColor: gradient,
                    borderRadius: 5, // Bo tròn góc cột
                    borderWidth: 0,
                    barThickness: 40 // Độ rộng cột
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false }, // Ẩn chú thích thừa
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f0f0f0' } // Lưới mờ
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });
    });
</script>