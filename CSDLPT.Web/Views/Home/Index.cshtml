@{
    ViewData["Title"] = "Dashboard Center";
    // Logic Serialize dữ liệu giữ nguyên
    var labelsJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ChartLabels);
    var valuesJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ChartValues);
}

<style>
    /* Style cho Form tìm kiếm */
    .search-input {
        background-color: rgba(0, 0, 0, 0.3) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: var(--text-primary) !important;
    }

        .search-input:focus {
            background-color: rgba(0, 0, 0, 0.5) !important;
            border-color: var(--accent-green) !important;
            box-shadow: none !important;
        }

        .search-input::placeholder {
            color: rgba(255, 255, 255, 0.3);
        }

    :root {
        --bg-body: #0f172a; /* Deep Navy */
        --bg-card: #1e293b; /* Slate 800 */
        --accent-green: #10b981; /* Emerald 500 */
        --text-primary: #f1f5f9;
        --text-secondary: #94a3b8;
    }

    body {
        background-color: var(--bg-body);
        color: var(--text-primary);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        overflow-x: hidden; /* Ngăn thanh cuộn ngang do ảnh nền */
    }

    /* === LAYOUT & Z-INDEX FIX === */
    .dashboard-container {
        position: relative;
        z-index: 10; /* Nội dung chính luôn nổi lên trên */
    }

    .side-decoration {
        position: fixed; /* Cố định vị trí khi cuộn */
        top: 50%;
        transform: translateY(-50%);
        width: 150px; /* Cố định chiều rộng ảnh nhỏ */
        z-index: 0; /* Nằm chìm dưới nội dung */
        opacity: 0.15; /* Mờ đi để không rối mắt */
        transition: all 0.5s ease;
        pointer-events: none; /* Không chặn click chuột vào nội dung chính */
    }

    .side-left {
        left: -20px;
    }

    .side-right {
        right: -20px;
    }

    /* Hiệu ứng hover nhẹ: Khi rê chuột ra vùng trống biên, logo sáng lên chút */
    body:hover .side-decoration {
        opacity: 0.3;
    }

    /* === CARDS === */
    .sport-card {
        background-color: var(--bg-card);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
        transition: transform 0.2s;
    }

        .sport-card:hover {
            transform: translateY(-2px);
            border-color: var(--accent-green);
        }

    .btn-pitch {
        background: linear-gradient(135deg, var(--accent-green), #059669);
        color: white;
        border: none;
        font-weight: 600;
    }

    /* Quick Links */
    .quick-link-item:hover {
        background: rgba(255, 255, 255, 0.08);
        padding-left: 1.2rem !important;
    }

    /* Tiêu đề Node */
    .node-title {
        color: #f1f5f9; /* Màu trắng sáng cho IP */
        font-family: 'Consolas', monospace; /* Font code cho IP đẹp hơn */
    }
</style>

<div class="side-decoration side-left">
    <img src="https://upload.wikimedia.org/wikipedia/en/thumb/5/56/Real_Madrid_CF.svg/1200px-Real_Madrid_CF.svg.png"
         class="img-fluid" alt="Club Logo 1">
</div>

<div class="side-decoration side-right">
    <img src="https://upload.wikimedia.org/wikipedia/en/thumb/7/7a/Manchester_United_FC_crest.svg/1200px-Manchester_United_FC_crest.svg.png"
         class="img-fluid" alt="Club Logo 2">
</div>

<div class="container-fluid py-4 dashboard-container">
    <div class="row justify-content-center">
        <div class="col-xl-10 col-12">

            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
                <div>
                    <h2 class="fw-bold text-white mb-1">
                        <i class="bi bi-speedometer2 text-success"></i> DASHBOARD
                    </h2>
                    <p class="text-secondary mb-0">Quản trị Hệ thống Phân tán (Node C - Coordinator)</p>
                </div>
                <button class="btn btn-pitch btn-sm shadow-sm px-4 py-2 rounded-pill" onclick="window.location.reload()">
                    <i class="bi bi-arrow-clockwise"></i> Làm mới
                </button>
            </div>

            <div class="row mb-4 g-3">
                @foreach (dynamic node in ViewBag.HealthStatus)
                {
                    <div class="col-md-4">
                        <div class="sport-card h-100 p-3">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-dark bg-opacity-50 p-3 me-3 border border-secondary">
                                    <i class="bi bi-server fs-4 text-success"></i>
                                </div>
                                <div>
                                    <h6 class="text-secondary small text-uppercase mb-0">@node.Node</h6>
                                    <h5 class="card-title mb-0 fw-bold node-title">@node.IP</h5>
                                    <small class="text-success fw-bold">
                                        <i class="bi bi-dot"></i> @node.Status
                                    </small>
                                </div>
                            </div>
                            <div class="mt-2 pt-2 border-top border-secondary opacity-50"></div>
                        </div>
                    </div>
                }
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="sport-card h-100">
                        <div class="card-header bg-transparent border-0 py-3">
                            <h5 class="mb-0 fw-bold text-white">
                                <i class="bi bi-bar-chart-fill me-2 text-success"></i>Thống kê Đội hình
                            </h5>
                        </div>
                        <div class="card-body">
                            <canvas id="playerChart" style="max-height: 300px;"></canvas>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="sport-card h-100 bg-gradient-to-b from-gray-800 to-gray-900">
                        <div class="card-body p-4">

                            <div class="mb-4">
                                <h5 class="fw-bold text-white mb-3">
                                    <i class="bi bi-search text-success me-2"></i>Tra cứu nhanh
                                </h5>
                                <form asp-controller="CauThu" asp-action="TraCuu" method="post">
                                    <div class="mb-1">
                                        <label class="text-secondary small mb-2">Nhập tên cầu thủ tra cứu thông tin:</label>
                                        <div class="input-group">
                                            <input type="text" class="form-control search-input rounded-start"
                                                   name="tuKhoaTen"
                                                   placeholder="VD: ...Antonio Rüdiger" required>
                                            <button class="btn btn-pitch px-3" type="submit">
                                                <i class="bi bi-arrow-right"></i>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>

                            <hr class="border-secondary opacity-25 my-4">

                            <h5 class="fw-bold text-white mb-3">
                                <i class="bi bi-grid-fill text-success me-2"></i>Menu Quản lý
                            </h5>

                            <a asp-controller="DoiBong" asp-action="Index" class="d-flex align-items-center text-white text-decoration-none mb-3 p-3 rounded quick-link-item" style="background: rgba(255,255,255,0.05)">
                                <div class="bg-dark bg-opacity-50 p-2 rounded me-3 text-success">
                                    <i class="bi bi-shield-shaded fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold">Đội Bóng</h6>
                                    <small class="text-secondary">Quản lý các CLB</small>
                                </div>
                                <i class="bi bi-chevron-right ms-auto text-secondary"></i>
                            </a>

                            <a asp-controller="CauThu" asp-action="Index" class="d-flex align-items-center text-white text-decoration-none mb-3 p-3 rounded quick-link-item" style="background: rgba(255,255,255,0.05)">
                                <div class="bg-dark bg-opacity-50 p-2 rounded me-3 text-success">
                                    <i class="bi bi-people-fill fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold">Cầu Thủ</h6>
                                    <small class="text-secondary">Hồ sơ & Chuyển nhượng</small>
                                </div>
                                <i class="bi bi-chevron-right ms-auto text-secondary"></i>
                            </a>

                            <a asp-controller="TranDau" asp-action="Index" class="d-flex align-items-center text-white text-decoration-none p-3 rounded quick-link-item" style="background: rgba(255,255,255,0.05)">
                                <div class="bg-dark bg-opacity-50 p-2 rounded me-3 text-success">
                                    <i class="bi bi-calendar-event fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold">Lịch Thi Đấu</h6>
                                    <small class="text-secondary">Cập nhật kết quả</small>
                                </div>
                                <i class="bi bi-chevron-right ms-auto text-secondary"></i>
                            </a>

                            <div class="mt-4 text-center">
                                <a asp-controller="CauThu" asp-action="TraCuu" class="text-secondary small text-decoration-none hover-text-green">
                                    Đến trang tra cứu nâng cao <i class="bi bi-arrow-up-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const ctx = document.getElementById('playerChart').getContext('2d');

        const labels = @Html.Raw(labelsJson);
        const dataValues = @Html.Raw(valuesJson);

        let gradient = ctx.createLinearGradient(0, 0, 0, 400);
        gradient.addColorStop(0, '#10B981');
        gradient.addColorStop(1, 'rgba(16, 185, 129, 0.1)');

        // Cấu hình màu chữ cho Dark Mode
        Chart.defaults.color = '#94a3b8';
        Chart.defaults.borderColor = 'rgba(255, 255, 255, 0.05)';

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Số cầu thủ',
                    data: dataValues,
                    backgroundColor: gradient,
                    borderRadius: 4,
                    barThickness: 40, // Tăng độ dày cột vì bây giờ có nhiều chỗ trống hơn
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false, // Cho phép chart tự co giãn theo chiều cao div
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(255, 255, 255, 0.05)' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });
    });
</script>