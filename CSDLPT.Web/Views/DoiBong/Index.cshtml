@model IEnumerable<CSDLPT.Web.Models.DoiBong>

@{
    ViewData["Title"] = "Quản Lý Đội Bóng";
    bool isGlobalView = (ViewData["IsGlobalView"] as bool?) ?? false;
}

<style>
    /* === 1. GLOBAL BACKGROUND FIX (Đồng bộ với Dashboard) === */
    body {
        background-color: #09090b !important; /* Nền đen sâu */
        color: #e2e8f0 !important; /* Chữ sáng màu */
        overflow-x: hidden;
    }

    /* === 2. SIDE DECORATIONS (Logo 2 bên cánh) === */
    .side-decoration {
        position: fixed;
        top: 50%;
        transform: translateY(-50%);
        width: 180px; /* Logo to hơn chút cho ngầu */
        z-index: 0; /* Chìm dưới nội dung */
        opacity: 0.1; /* Rất mờ để không rối mắt */
        pointer-events: none; /* Cho phép click xuyên qua */
        transition: opacity 0.3s;
    }

    .side-left {
        left: -30px;
    }

    .side-right {
        right: -30px;
    }

    /* Hover vào vùng biên thì logo sáng lên */
    body:hover .side-decoration {
        opacity: 0.2;
    }

    /* === 3. CONTAINER FIX (Đẩy Footer xuống đáy) === */
    .main-content-wrapper {
        position: relative;
        z-index: 10; /* Nổi lên trên logo nền */
        min-height: 85vh; /* <--- KEY FIX: Chiều cao tối thiểu đễ Footer không bị treo */
        padding-bottom: 3rem;
    }

    /* === 4. TABLE STYLES (Dark Mode) === */
    .table-container {
        background-color: #18181b; /* Zinc 950 */
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
    }

    .table-custom {
        margin-bottom: 0;
        color: #e2e8f0;
    }

        .table-custom thead th {
            background-color: #27272a;
            color: #94a3b8;
            text-transform: uppercase;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 1px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding: 1.2rem 1rem;
        }

        .table-custom tbody td {
            padding: 1rem;
            vertical-align: middle;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .table-custom tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.03);
        }

    /* === 5. ACTION BUTTONS FIX (Sửa lỗi nút đen) === */
    .btn-icon {
        width: 35px;
        height: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s;
        /* Mặc định: Nền trong suốt, Icon màu xám sáng */
        background: rgba(255, 255, 255, 0.05);
        color: #cbd5e1;
        border: 1px solid rgba(255, 255, 255, 0.1);
        margin-left: 5px;
        text-decoration: none; /* Xóa gạch chân link */
    }

    /* Hover Effects: Đổi màu theo hành động */
    .btn-edit:hover {
        background: rgba(251, 191, 36, 0.2);
        color: #fbbf24; /* Vàng */
        border-color: #fbbf24;
    }

    .btn-detail:hover {
        background: rgba(56, 189, 248, 0.2);
        color: #38bdf8; /* Xanh dương */
        border-color: #38bdf8;
    }

    .btn-delete:hover {
        background: rgba(244, 63, 94, 0.2);
        color: #f43f5e; /* Đỏ hồng */
        border-color: #f43f5e;
    }

    /* === NODE BADGES === */
    .badge-node {
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .node-a {
        background: rgba(244, 63, 94, 0.1);
        color: #f43f5e;
        border: 1px solid rgba(244, 63, 94, 0.2);
    }

    .node-b {
        background: rgba(251, 191, 36, 0.1);
        color: #fbbf24;
        border: 1px solid rgba(251, 191, 36, 0.2);
    }

    .node-c {
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    /* Control Card */
    .control-card {
        background: #18181b;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
    }
</style>

<div class="side-decoration side-left">
    <img src="https://upload.wikimedia.org/wikipedia/en/thumb/5/56/Real_Madrid_CF.svg/1200px-Real_Madrid_CF.svg.png" class="img-fluid" alt="Decor Left">
</div>
<div class="side-decoration side-right">
    <img src="https://upload.wikimedia.org/wikipedia/en/thumb/7/7a/Manchester_United_FC_crest.svg/1200px-Manchester_United_FC_crest.svg.png" class="img-fluid" alt="Decor Right">
</div>

<div class="container-fluid py-4 main-content-wrapper">

    <div class="row justify-content-center">
        <div class="col-xl-10 col-12">

            <div class="d-flex justify-content-between align-items-end mb-4 border-bottom border-secondary border-opacity-25 pb-3">
                <div>
                    <h6 class="text-secondary text-uppercase small letter-spacing-2 mb-1">Management Console</h6>
                    <h2 class="text-white fw-bold mb-0 display-6">
                        <i class="bi bi-shield-shaded text-success me-2"></i>ĐỘI BÓNG
                    </h2>
                </div>
                <a asp-action="Create" class="btn btn-success fw-bold shadow-lg px-4">
                    <i class="bi bi-plus-lg"></i> <span class="d-none d-md-inline">Thêm Mới</span>
                </a>
            </div>

            @if (ViewBag.SystemAlerts != null)
            {
                var errors = ViewBag.SystemAlerts as List<string>;
                if (errors != null && errors.Count > 0)
                {
                    foreach (var err in errors)
                    {
                        <div class="alert alert-danger bg-danger bg-opacity-10 border-danger text-danger d-flex align-items-center shadow-sm" role="alert">
                            <i class="bi bi-lightning-fill me-3 fs-5"></i>
                            <div><strong>System Error:</strong> @err</div>
                            <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert"></button>
                        </div>
                    }
                }
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-warning bg-warning bg-opacity-10 border-warning text-warning shadow-sm" role="alert">
                    <i class="bi bi-info-circle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="control-card p-3 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center">
                    <div class="bg-white bg-opacity-5 p-2 rounded-3 me-3">
                        <i class="bi bi-hdd-network fs-4 text-white"></i>
                    </div>
                    <div>
                        <small class="text-secondary text-uppercase" style="font-size: 0.7rem;">Data Source Mode</small>
                        <div class="fw-bold">
                            @if (isGlobalView)
                            {
                                <span class="text-info"><i class="bi bi-globe me-1"></i> GLOBAL (Toàn Cục)</span>
                            }
                            else
                            {
                                <span class="text-success"><i class="bi bi-layers-fill me-1"></i> LOCAL (Phân Mảnh C)</span>
                            }
                        </div>
                    </div>
                </div>

                <div>
                    @if (isGlobalView)
                    {
                        <a asp-action="Index" asp-route-showGlobal="false" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-return-left me-2"></i>Switch to Local
                        </a>
                    }
                    else
                    {
                        <a asp-action="Index" asp-route-showGlobal="true" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-cloud-download-fill me-2"></i>Load Global Data
                        </a>
                    }
                </div>
            </div>

            <div class="table-container">
                <table class="table table-custom table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Mã Đội</th>
                            <th>Tên Đội Bóng</th>
                            <th>Mã CLB</th>
                            <th>Sân Nhà</th>
                            <th>HLV Trưởng</th>
                            <th class="text-center">Chi Nhánh</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            // Logic màu sắc Node
                            string nodeClass = "node-c";
                            string nodeLabel = item.SourceNode;

                            if (string.IsNullOrEmpty(nodeLabel)) { nodeLabel = "Node C"; }

                            if (nodeLabel.Contains("A") || nodeLabel.Contains("NodeA")) { nodeClass = "node-a"; }
                            else if (nodeLabel.Contains("B") || nodeLabel.Contains("NodeB")) { nodeClass = "node-b"; }
                            else { nodeClass = "node-c"; }

                            <tr>
                                <td class="fw-bold font-monospace text-white">@item.MaDB</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 d-flex align-items-center justify-content-center me-3 fw-bold"
                                             style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            @item.TenDB.Substring(0, 1)
                                        </div>
                                        <span class="text-white">@item.TenDB</span>
                                    </div>
                                </td>
                                <td><span class="badge bg-white bg-opacity-5 text-secondary fw-normal border border-secondary border-opacity-25">@item.CLB</span></td>
                                <td>@item.MaSan</td>
                                <td class="text-secondary small">@item.HLV</td>

                                <td class="text-center">
                                    <span class="badge-node @nodeClass">
                                        @nodeLabel
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.MaDB" class="btn-icon btn-edit" title="Sửa">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.MaDB" class="btn-icon btn-detail" title="Chi tiết">
                                        <i class="bi bi-info-circle-fill"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.MaDB" class="btn-icon btn-delete" title="Xóa">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <div class="mb-3">
                            <i class="bi bi-inbox text-secondary opacity-25" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="text-secondary">Chưa có dữ liệu</h5>
                        <p class="text-secondary small opacity-75">Hãy chuyển sang chế độ Toàn Cục hoặc thêm mới.</p>
                    </div>
                }
            </div>

        </div>
    </div>
</div>