@model IEnumerable<CSDLPT.Web.Models.TranDau>

@{
    ViewData["Title"] = "Lịch Thi Đấu";
}

<style>
    :root {
        --bg-body: #0f172a;
        --bg-card: #1e293b;
        --accent-green: #10b981;
        --accent-orange: #f59e0b;
        --text-primary: #f1f5f9;
        --text-secondary: #94a3b8;
    }

    body {
        background-color: var(--bg-body);
        color: var(--text-primary);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Dashboard Header */
    .page-header {
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
    }

    /* Table Card */
    .table-card {
        background-color: var(--bg-card);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    /* Custom Table Styles */
    .table-custom {
        margin-bottom: 0;
        color: var(--text-primary);
    }

        .table-custom thead th {
            background-color: rgba(15, 23, 42, 0.5); /* Darker header */
            color: var(--text-secondary);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            border-bottom: 2px solid rgba(255, 255, 255, 0.05);
            padding: 1rem;
        }

        .table-custom tbody td {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding: 1rem;
            vertical-align: middle;
        }

        .table-custom tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.02);
        }

    /* Badges & Typography */
    .code-font {
        font-family: 'Consolas', monospace;
        color: var(--accent-green);
        background: rgba(16, 185, 129, 0.1);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.9rem;
    }

    .stadium-badge {
        font-family: 'Consolas', monospace;
        background: rgba(245, 158, 11, 0.15);
        color: var(--accent-orange);
        border: 1px solid rgba(245, 158, 11, 0.3);
        padding: 2px 8px;
        border-radius: 4px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .round-info {
        font-size: 0.85rem;
        color: var(--text-secondary);
    }

    .date-highlight {
        font-weight: 600;
        color: #fff;
    }

    /* Buttons */
    .btn-create {
        background: linear-gradient(135deg, var(--accent-green), #059669);
        color: white;
        border: none;
        font-weight: 600;
        padding: 0.5rem 1.5rem;
        border-radius: 50px;
        transition: transform 0.2s;
    }

        .btn-create:hover {
            transform: translateY(-2px);
            color: white;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
        }

    .action-btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        transition: all 0.2s;
        color: var(--text-secondary);
        background: rgba(255,255,255,0.05);
        margin-right: 4px;
    }

        .action-btn:hover {
            color: white;
        }

    .btn-edit:hover {
        background-color: #3b82f6;
    }
    /* Blue */
    .btn-detail:hover {
        background-color: #10b981;
    }
    /* Green */
    .btn-delete:hover {
        background-color: #ef4444;
    }
    /* Red */

</style>

<div class="container-fluid py-4 px-md-5">

    <div class="d-flex justify-content-between align-items-center page-header">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-calendar-event text-success me-2"></i>Lịch Thi Đấu</h2>
            <p class="text-secondary mb-0">Quản lý các trận đấu và địa điểm tổ chức (Phân tán theo Mã Sân).</p>
        </div>
        <a asp-action="Create" class="btn btn-create shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>Tạo Trận Đấu
        </a>
    </div>

    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-custom">
                <thead>
                    <tr>
                        <th>Mã Trận (PK)</th>
                        <th>Thời Gian</th>
                        <th>Sân Tổ Chức (Routing)</th>
                        <th>Thông tin Vòng đấu</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="code-font">@Html.DisplayFor(modelItem => item.MaTD)</span>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-clock-history text-secondary me-2"></i>
                                        <span class="date-highlight">
                                            @if (item.NgayThiDau.HasValue)
                                            {
                                                @item.NgayThiDau.Value.ToString("dd/MM/yyyy HH:mm")
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">Chưa xếp lịch</span>
                                            }
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <span class="stadium-badge" title="Dữ liệu nằm tại Site chứa sân này">
                                        <i class="bi bi-geo-alt-fill me-1"></i>@Html.DisplayFor(modelItem => item.MaSan)
                                    </span>
                                </td>

                                <td>
                                    <div class="round-info">
                                        <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25 me-1">
                                            Vòng @Html.DisplayFor(modelItem => item.VongDau)
                                        </span>
                                        <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25">
                                            Lượt @Html.DisplayFor(modelItem => item.LuotDau)
                                        </span>
                                    </div>
                                </td>

                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.MaTD" class="action-btn btn-edit" title="Sửa">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.MaTD" class="action-btn btn-detail" title="Chi tiết">
                                        <i class="bi bi-info-lg"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.MaTD" class="action-btn btn-delete" title="Xóa">
                                        <i class="bi bi-trash3-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-secondary">
                                <i class="bi bi-inbox fs-1 d-block mb-3 opacity-50"></i>
                                Chưa có dữ liệu trận đấu nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>