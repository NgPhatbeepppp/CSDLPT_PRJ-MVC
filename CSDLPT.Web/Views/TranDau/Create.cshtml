@model CSDLPT.Web.Models.TranDau

@{
    ViewData["Title"] = "Tạo Trận Đấu Mới";
}

<style>
    /* 1. Khai báo biến màu (Theme Dark Mode) */
    :root {
        --bg-body: #0f172a; /* Màu nền chính tối hơn Card */
        --bg-card: #1e293b; /* Màu nền Card */
        --accent-green: #10b981;
        --text-primary: #f1f5f9;
        --text-secondary: #94a3b8;
        --input-bg: #334155;
        --input-border: #475569;
    }

    /* 2. FIX QUAN TRỌNG: Áp dụng màu nền cho body của trang này */
    body {
        background-color: var(--bg-body) !important;
        color: var(--text-primary);
    }

    /* Override Form Control */
    .form-control, .form-select {
        background-color: var(--input-bg);
        border: 1px solid var(--input-border);
        color: var(--text-primary);
        border-radius: 8px;
        padding: 10px 15px;
    }

        .form-control:focus, .form-select:focus {
            background-color: #0f172a;
            border-color: var(--accent-green);
            color: var(--text-primary);
            box-shadow: 0 0 0 0.25rem rgba(16, 185, 129, 0.25);
        }

    .form-label {
        color: var(--text-secondary);
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    /* Card Style */
    .sport-card {
        background-color: var(--bg-card);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }

    .card-header-custom {
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding-bottom: 15px;
        margin-bottom: 20px;
    }

    /* VS Badge */
    .vs-badge {
        background: linear-gradient(135deg, var(--accent-green), #059669);
        color: white;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-style: italic;
        box-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
        margin: 0 auto;
        position: relative;
        z-index: 2;
    }

    .vs-connector {
        position: absolute;
        top: 50%;
        left: 10%;
        right: 10%;
        height: 1px;
        background: rgba(255,255,255,0.1);
        z-index: 1;
    }

    .btn-pitch {
        background: linear-gradient(135deg, var(--accent-green), #059669);
        color: white;
        border: none;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-pitch:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
            color: white;
        }

    /* 3. FIX FOOTER: Đảm bảo vùng chứa chính có chiều cao tối thiểu */
    .main-content-wrapper {
        min-height: 85vh; /* Chiếm ít nhất 85% chiều cao màn hình để đẩy Footer xuống */
        display: flex;
        flex-direction: column;
    }
</style>

<div class="container py-4 main-content-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white mb-1">
                <i class="bi bi-calendar-plus text-success me-2"></i>Tạo Trận Đấu
            </h2>
            <p class="text-secondary mb-0">Thiết lập lịch thi đấu và địa điểm (Node Routing)</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 text-danger border-danger"></div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="sport-card p-4 h-100">
                    <div class="card-header-custom">
                        <h5 class="text-white fw-bold m-0"><i class="bi bi-info-circle me-2 text-success"></i>Thông tin chung</h5>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NgayThiDau" class="form-label">Ngày Giờ Thi Đấu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-clock"></i></span>
                            <input asp-for="NgayThiDau" class="form-control" type="datetime-local" />
                        </div>
                        <span asp-validation-for="NgayThiDau" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaSan" class="form-label">Sân Vận Động <span class="text-success">(Quyết định Node)</span></label>
                        <select asp-for="MaSan" class="form-select" asp-items="ViewBag.MaSanList">
                            <option value="">-- Chọn Sân --</option>
                        </select>
                        <div class="form-text text-secondary fst-italic small">
                            <i class="bi bi-hdd-network"></i> Chọn sân sẽ định tuyến dữ liệu về Node A (SD1), Node B (SD2) hoặc Node C (SD3).
                        </div>
                        <span asp-validation-for="MaSan" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="LuotDau" class="form-label">Lượt Đấu</label>
                                <input asp-for="LuotDau" class="form-control" type="number" min="1" placeholder="1" />
                                <span asp-validation-for="LuotDau" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="mb-3">
                                <label asp-for="VongDau" class="form-label">Vòng Đấu</label>
                                <input asp-for="VongDau" class="form-control" type="number" min="1" placeholder="1" />
                                <span asp-validation-for="VongDau" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="sport-card p-4 h-100">
                    <div class="card-header-custom">
                        <h5 class="text-white fw-bold m-0"><i class="bi bi-shield-shaded me-2 text-success"></i>Đội Hình Đối Đầu</h5>
                    </div>

                    <div class="row align-items-center position-relative py-4">
                        <div class="vs-connector"></div>

                        <div class="col-md-5 z-index-2">
                            <div class="p-3 rounded text-center" style="background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.1)">
                                <i class="bi bi-house-door-fill fs-1 text-secondary mb-3 d-block"></i>
                                <label asp-for="MaDoiNha" class="form-label text-success text-uppercase">Đội Nhà (Host)</label>
                                <select asp-for="MaDoiNha" class="form-select form-select-lg text-center" asp-items="ViewBag.DoiBongList">
                                    <option value="">-- Chọn Đội --</option>
                                </select>
                                <span asp-validation-for="MaDoiNha" class="text-danger small d-block mt-2"></span>
                            </div>
                        </div>

                        <div class="col-md-2 text-center my-3 my-md-0 z-index-2">
                            <div class="vs-badge">VS</div>
                        </div>

                        <div class="col-md-5 z-index-2">
                            <div class="p-3 rounded text-center" style="background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.1)">
                                <i class="bi bi-airplane-fill fs-1 text-secondary mb-3 d-block"></i>
                                <label asp-for="MaDoiKhach" class="form-label text-danger text-uppercase">Đội Khách (Guest)</label>
                                <select asp-for="MaDoiKhach" class="form-select form-select-lg text-center" asp-items="ViewBag.DoiBongList">
                                    <option value="">-- Chọn Đội --</option>
                                </select>
                                <span asp-validation-for="MaDoiKhach" class="text-danger small d-block mt-2"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 text-end">
                        <button type="submit" class="btn btn-pitch btn-lg rounded-pill px-5">
                            <i class="bi bi-plus-circle me-2"></i>Hoàn Tất & Tạo Mới
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // UX Script: Ngăn chọn trùng đội
        $(document).ready(function() {
            $('select').change(function() {
                var home = $('#MaDoiNha').val();
                var away = $('#MaDoiKhach').val();

                if(home && away && home === away) {
                    alert('Đội nhà và Đội khách không được trùng nhau!');
                    $(this).val(''); // Reset giá trị vừa chọn
                }
            });
        });
    </script>
}