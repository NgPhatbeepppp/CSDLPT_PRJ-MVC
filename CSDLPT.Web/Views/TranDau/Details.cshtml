@model CSDLPT.Web.Models.TranDauDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết Trận Đấu";

    // Helper function để lấy tên đội an toàn (có xử lý Trim)
    string GetTenDoi(string maDoi)
    {
        if (string.IsNullOrEmpty(maDoi)) return "N/A";
        var maClean = maDoi.Trim(); // Cắt khoảng trắng thừa từ DB
        return Model.TenDoiBongLookup.ContainsKey(maClean)
               ? Model.TenDoiBongLookup[maClean]
               : maDoi;
    }

    var tenDoiNha = GetTenDoi(Model.TranDau.MaDoiNha);
    var tenDoiKhach = GetTenDoi(Model.TranDau.MaDoiKhach);
}

<div class="container mt-4">
    @* --- PHẦN TỈ SỐ (SCORE BOARD) --- *@
    <div class="card text-center shadow-sm mb-4">
        <div class="card-header bg-light">
            KẾT QUẢ TRẬN ĐẤU
        </div>
        <div class="card-body">
            <div class="row align-items-center justify-content-center">
                @* Đội Nhà *@
                <div class="col-4 text-end">
                    <h3 class="text-primary fw-bold">@tenDoiNha</h3>
                </div>

                @* Tỉ số (Dùng badge bg-primary của Bootstrap 5) *@
                <div class="col-auto">
                    <div class="d-flex align-items-center">
                        <span class="badge bg-primary fs-2 mx-2 shadow">@Model.TongSoTrai_DoiNha</span>
                        <span class="fs-3 text-muted">-</span>
                        <span class="badge bg-danger fs-2 mx-2 shadow">@Model.TongSoTrai_DoiKhach</span>
                    </div>
                </div>

                @* Đội Khách *@
                <div class="col-4 text-start">
                    <h3 class="text-danger fw-bold">@tenDoiKhach</h3>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        @* --- CỘT TRÁI: THÊM CẦU THỦ --- *@
        <div class="col-lg-4 mb-4">
            <div class="card h-100 border-info">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-person-plus-fill"></i> Thêm Cầu Thủ Vào Trận
                </div>
                <div class="card-body">
                    <form asp-action="BatchAddThamGia" method="post">
                        <input type="hidden" name="MaTD" value="@Model.TranDau.MaTD" />

                        <ul class="nav nav-tabs" id="teamTab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#doiNhaTab" type="button" role="tab">Đội Nhà</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="away-tab" data-bs-toggle="tab" data-bs-target="#doiKhachTab" type="button" role="tab">Đội Khách</button>
                            </li>
                        </ul>

                        <div class="tab-content p-2 border border-top-0 rounded-bottom" style="background: #f8f9fa;">
                            @* Tab Đội Nhà *@
                            <div class="tab-pane fade show active" id="doiNhaTab" role="tabpanel">
                                @if (!Model.CauThuDoiNha_ChuaThamGia.Any())
                                {
                                    <p class="text-muted small mt-2">Đã thêm hết cầu thủ.</p>
                                }
                                else
                                {
                                    <div style="max-height: 300px; overflow-y: auto;">
                                        @foreach (var ct in Model.CauThuDoiNha_ChuaThamGia)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="SelectedCauThuIds" value="@ct.MaCT" id="ct_@ct.MaCT">
                                                <label class="form-check-label small" for="ct_@ct.MaCT">@ct.HoTen (@ct.MaCT)</label>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            @* Tab Đội Khách *@
                            <div class="tab-pane fade" id="doiKhachTab" role="tabpanel">
                                @if (!Model.CauThuDoiKhach_ChuaThamGia.Any())
                                {
                                    <p class="text-muted small mt-2">Đã thêm hết cầu thủ.</p>
                                }
                                else
                                {
                                    <div style="max-height: 300px; overflow-y: auto;">
                                        @foreach (var ct in Model.CauThuDoiKhach_ChuaThamGia)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="SelectedCauThuIds" value="@ct.MaCT" id="ct_@ct.MaCT">
                                                <label class="form-check-label small" for="ct_@ct.MaCT">@ct.HoTen (@ct.MaCT)</label>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success w-100 mt-3">
                            <i class="bi bi-plus-lg"></i> Thêm Đã Chọn
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @* --- CỘT PHẢI: DANH SÁCH ĐÃ THAM GIA --- *@
        <div class="col-lg-8">
            @* Bảng Đội Nhà *@
            <div class="card mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <span>ĐỘI NHÀ: <strong>@tenDoiNha</strong></span>
                    <span class="badge bg-light text-primary">@Model.DanhSachThamGia_DoiNha.Count cầu thủ</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Cầu Thủ</th>
                                <th style="width: 150px;">Bàn Thắng</th>
                                <th style="width: 100px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.DanhSachThamGia_DoiNha)
                            {
                                <tr>
                                    <td>
                                        @if (Model.TenCauThuLookup.ContainsKey(item.MaCT.Trim()))
                                        {
                                            @Model.TenCauThuLookup[item.MaCT.Trim()]
                                        }
                                        else
                                        {
                                            <span class="text-muted">@item.MaCT</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="UpdateThamGiaSoTrai" method="post" class="d-flex">
                                            <input type="hidden" name="MaTD" value="@item.MaTD" />
                                            <input type="hidden" name="MaCT" value="@item.MaCT" />
                                            <input type="number" name="SoTrai" value="@item.SoTrai" class="form-control form-control-sm me-1" min="0" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Lưu"><i class="bi bi-save"></i></button>
                                        </form>
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="DeleteThamGia" method="post" onsubmit="return confirm('Xóa cầu thủ này khỏi trận đấu?');">
                                            <input type="hidden" name="MaTD" value="@item.MaTD" />
                                            <input type="hidden" name="MaCT" value="@item.MaCT" />
                                            <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (Model.DanhSachThamGia_DoiNha.Count == 0)
                            {
                                <tr><td colspan="3" class="text-center text-muted py-3">Chưa có cầu thủ nào</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* Bảng Đội Khách *@
            <div class="card">
                <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                    <span>ĐỘI KHÁCH: <strong>@tenDoiKhach</strong></span>
                    <span class="badge bg-light text-danger">@Model.DanhSachThamGia_DoiKhach.Count cầu thủ</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Cầu Thủ</th>
                                <th style="width: 150px;">Bàn Thắng</th>
                                <th style="width: 100px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.DanhSachThamGia_DoiKhach)
                            {
                                <tr>
                                    <td>
                                        @if (Model.TenCauThuLookup.ContainsKey(item.MaCT.Trim()))
                                        {
                                            @Model.TenCauThuLookup[item.MaCT.Trim()]
                                        }
                                        else
                                        {
                                            <span class="text-muted">@item.MaCT</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="UpdateThamGiaSoTrai" method="post" class="d-flex">
                                            <input type="hidden" name="MaTD" value="@item.MaTD" />
                                            <input type="hidden" name="MaCT" value="@item.MaCT" />
                                            <input type="number" name="SoTrai" value="@item.SoTrai" class="form-control form-control-sm me-1" min="0" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Lưu"><i class="bi bi-save"></i></button>
                                        </form>
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="DeleteThamGia" method="post" onsubmit="return confirm('Xóa cầu thủ này khỏi trận đấu?');">
                                            <input type="hidden" name="MaTD" value="@item.MaTD" />
                                            <input type="hidden" name="MaCT" value="@item.MaCT" />
                                            <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (Model.DanhSachThamGia_DoiKhach.Count == 0)
                            {
                                <tr><td colspan="3" class="text-center text-muted py-3">Chưa có cầu thủ nào</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>