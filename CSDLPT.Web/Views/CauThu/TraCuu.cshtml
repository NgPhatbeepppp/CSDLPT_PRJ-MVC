@model IEnumerable<CSDLPT.Web.Models.LichSuThiDauViewModel>

@{
    ViewData["Title"] = "Tra cứu cầu thủ";
}

<style>
    /* === MANG STYLE TỪ DASHBOARD SANG === */
    :root {
        --bg-body: #0f172a; /* Deep Navy */
        --bg-card: #1e293b; /* Slate 800 */
        --accent-green: #10b981; /* Emerald 500 */
        --text-primary: #f1f5f9;
        --text-secondary: #94a3b8;
    }

    body {
        background-color: var(--bg-body);
        color: var(--text-primary);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* === SEARCH BAR CUSTOM === */
    .search-input-lg {
        background-color: rgba(0, 0, 0, 0.3) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: var(--text-primary) !important;
        font-size: 1.1rem;
        padding: 0.8rem 1.5rem;
        border-radius: 50px 0 0 50px; /* Bo tròn bên trái */
        transition: all 0.3s ease;
    }

        .search-input-lg:focus {
            background-color: rgba(0, 0, 0, 0.5) !important;
            border-color: var(--accent-green) !important;
            box-shadow: 0 0 15px rgba(16, 185, 129, 0.2) !important;
        }

    .btn-search {
        background: linear-gradient(135deg, var(--accent-green), #059669);
        color: white;
        border: none;
        border-radius: 0 50px 50px 0; /* Bo tròn bên phải */
        padding: 0 2rem;
        font-weight: 600;
        transition: transform 0.2s;
    }

        .btn-search:hover {
            transform: translateX(2px);
            color: white;
        }

    /* === STATS CARDS === */
    .stat-card {
        background: rgba(30, 41, 59, 0.7); /* Mờ nhẹ */
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        transition: transform 0.2s, border-color 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: var(--accent-green);
        }

    .stat-icon-wrapper {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(16, 185, 129, 0.1);
        color: var(--accent-green);
    }

    /* === DATA TABLE === */
    .custom-table-container {
        background-color: var(--bg-card);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        overflow: hidden; /* Bo góc cho bảng */
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }

    .table-dark-custom {
        margin-bottom: 0;
        color: var(--text-secondary);
    }

        .table-dark-custom thead th {
            background-color: rgba(0, 0, 0, 0.2);
            color: var(--accent-green);
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding: 1rem;
        }

        .table-dark-custom td {
            vertical-align: middle;
            padding: 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .table-dark-custom tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.02);
        }

    /* Font code cho các mã định danh */
    .code-font {
        font-family: 'Consolas', monospace;
        color: #e2e8f0;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-xl-10">

            <div class="d-flex align-items-center mb-5">
                <a href="/Home/Index" class="btn btn-outline-secondary btn-sm rounded-pill me-3 border-secondary text-light">
                    <i class="bi bi-arrow-left"></i> Dashboard
                </a>
                <div>
                    <h3 class="fw-bold text-white mb-0">Tra Cứu Lịch Sử Thi Đấu</h3>
                    <small class="text-secondary">Hệ thống CSDL Phân Tán (Global View)</small>
                </div>
            </div>

            <div class="mb-5 text-center">
                <form asp-action="TraCuu" method="post" class="w-100" style="max-width: 700px; margin: 0 auto;">
                    <div class="input-group input-group-lg shadow-lg">
                        <span class="input-group-text bg-transparent border-0 position-absolute" style="z-index: 10; left: 15px; top: 12px; color: var(--text-secondary);">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control search-input-lg ps-5"
                               name="tuKhoaTen"
                               value="@ViewBag.TuKhoa"
                               placeholder="Nhập tên cầu thủ (VD: Messi, Ronaldo, ...)"
                               autocomplete="off" required>
                        <button class="btn btn-search" type="submit">
                            TÌM KIẾM
                        </button>
                    </div>
                    <div class="mt-2 text-secondary small fst-italic">
                        * Dữ liệu được truy vấn từ View toàn cục (Global View) hợp nhất 3 Site.
                    </div>
                </form>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="row g-4 mb-4 animate__animated animate__fadeInUp">
                    <div class="col-md-6">
                        <div class="stat-card p-4 d-flex align-items-center">
                            <div class="stat-icon-wrapper me-3">
                                <i class="bi bi-activity fs-4"></i>
                            </div>
                            <div>
                                <h6 class="text-secondary text-uppercase small mb-1">Tổng số trận đấu</h6>
                                <h2 class="fw-bold text-white m-0">@ViewBag.TongSoTran</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="stat-card p-4 d-flex align-items-center">
                            <div class="stat-icon-wrapper me-3">
                                <i class="bi bi-trophy-fill fs-4"></i>
                            </div>
                            <div>
                                <h6 class="text-secondary text-uppercase small mb-1">Tổng bàn thắng</h6>
                                <h2 class="fw-bold text-white m-0">@ViewBag.TongBanThang</h2>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="custom-table-container animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
                    <div class="p-3 border-bottom border-secondary border-opacity-10 d-flex justify-content-between align-items-center">
                        <h5 class="text-white mb-0 fw-bold">
                            <i class="bi bi-list-columns-reverse me-2 text-success"></i>Chi tiết thành tích
                        </h5>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                            Kết quả: @Model.Count() bản ghi
                        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-dark-custom text-nowrap">
                            <thead>
                                <tr>
                                    <th class="ps-4">Mã Trận</th>
                                    <th>Thời Gian / Ngày</th>
                                    <th>Sân Thi Đấu</th>
                                    <th>Họ Tên Cầu Thủ</th>
                                    <th class="text-center">Thành Tích</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="code-font fw-bold">@item.MaTD</span>
                                        </td>
                                        <td>
                                            @if (item.NgayThiDau.HasValue)
                                            {
                                                <div class="d-flex flex-column">
                                                    <span class="text-white">@item.NgayThiDau.Value.ToString("dd/MM/yyyy")</span>
                                                    <small class="text-secondary" style="font-size: 0.75rem;">
                                                        @item.NgayThiDau.Value.ToString("HH:mm")
                                                    </small>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">-- Chưa cập nhật --</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25 px-3 py-2">
                                                <i class="bi bi-geo-alt-fill me-1 text-danger"></i> @item.MaSan
                                            </span>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-white">@item.Hoten</span>
                                        </td>
                                        <td class="text-center">
                                            @if (item.SoBanThang > 0)
                                            {
                                                <span class="d-inline-flex align-items-center text-success fw-bold">
                                                    <span class="fs-5 me-1">@item.SoBanThang</span>
                                                    <i class="bi bi-dribbble"></i>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary opacity-50">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (ViewBag.TuKhoa != null)
            {
                <div class="text-center mt-5 animate__animated animate__fadeIn">
                    <div class="mb-3">
                        <i class="bi bi-search text-secondary opacity-25" style="font-size: 4rem;"></i>
                    </div>
                    <h5 class="text-white">Không tìm thấy dữ liệu</h5>
                    <p class="text-secondary">
                        Không có kết quả nào cho từ khóa <strong class="text-warning">"@ViewBag.TuKhoa"</strong>.
                        <br>Vui lòng kiểm tra lại chính tả hoặc thử tên khác.
                    </p>
                </div>
            }

        </div>
    </div>
</div>